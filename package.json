{
  "name": "deckforge",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Deckforge v2 — Retool for presentations. MCP server + live canvas + pptx export from one validated deck state.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:canvas": "npm run build -w @deckforge/canvas",
    "serve": "tsx packages/server/src/main.ts",
    "mcp": "tsx packages/server/src/main.ts --stdio",
    "gen:metrics": "tsx scripts/gen-metrics.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "opentype.js": "^2.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.1"
  }
}
